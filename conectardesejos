<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConectaDesejos - Realize & Transforme</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen pb-24">

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-100 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-2">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-pink-500 to-purple-600 flex items-center justify-center text-white shadow-md shadow-pink-500/20">
                <i class="fa-solid fa-heart-pulse text-lg"></i>
            </div>
            <div>
                <h1 class="font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-600 to-purple-600 text-lg leading-tight">ConectaDesejos</h1>
                <p class="text-[10px] text-slate-400 font-medium tracking-wide uppercase">Realize & Transforme</p>
            </div>
        </div>
        <button onclick="openPublishModal()" class="bg-gradient-to-r from-pink-600 to-purple-600 text-white px-4 py-2 rounded-xl text-xs font-bold shadow-lg shadow-purple-500/20 active:scale-95 transition-all flex items-center space-x-1.5">
            <i class="fa-solid fa-plus"></i>
            <span>Publicar Desejo</span>
        </button>
    </header>

    <!-- Categories Bar -->
    <div class="px-4 py-3 bg-white border-b border-slate-100 overflow-x-auto hide-scrollbar flex space-x-2 shrink-0">
        <button onclick="filterCategory('Todos')" class="cat-btn px-4 py-1.5 rounded-full text-xs font-bold bg-purple-600 text-white shrink-0 transition-all shadow-sm">Todos</button>
        <button onclick="filterCategory('Aprendizado')" class="cat-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition-all">📚 Aprendizado</button>
        <button onclick="filterCategory('Apoio Emocional')" class="cat-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition-all">💬 Apoio Emocional</button>
        <button onclick="filterCategory('Habilidades')" class="cat-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition-all">⚡ Habilidades</button>
        <button onclick="filterCategory('Outros')" class="cat-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition-all">✨ Outros</button>
    </div>

    <!-- Main Content Area -->
    <main class="max-w-xl mx-auto p-4 space-y-4" id="feed-container">
        <!-- Cards serão injetados via JavaScript -->
    </main>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed bottom-0 left-0 right-0 bg-white/90 backdrop-blur-md border-t border-slate-100 px-6 py-2.5 flex justify-around items-center z-40 max-w-xl mx-auto">
        <button onclick="switchTab('feed')" class="flex flex-col items-center space-y-1 text-purple-600" id="nav-feed">
            <i class="fa-solid fa-compass text-lg"></i>
            <span class="text-[10px] font-bold">Desejos</span>
        </button>
        <button onclick="openPublishModal()" class="w-12 h-12 bg-gradient-to-tr from-pink-500 to-purple-600 rounded-full flex items-center justify-center text-white shadow-lg shadow-purple-500/30 -mt-5 active:scale-95 transition-all">
            <i class="fa-solid fa-plus text-base"></i>
        </button>
        <button onclick="switchTab('agenda')" class="flex flex-col items-center space-y-1 text-slate-400 hover:text-slate-600" id="nav-agenda">
            <i class="fa-solid fa-calendar-check text-lg"></i>
            <span class="text-[10px] font-bold">Agenda</span>
        </button>
    </nav>

    <!-- Modal: Publicar Desejo -->
    <div id="publish-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-white w-full max-w-lg rounded-t-3xl sm:rounded-3xl p-6 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                <h3 class="font-extrabold text-slate-800 text-base">Publicar Novo Desejo</h3>
                <button onclick="closePublishModal()" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <form id="publish-form" onsubmit="handlePublish(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Seu Nome / Apelido</label>
                    <input type="text" id="pub-author" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none" placeholder="Ex: Mirene">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Categoria</label>
                    <select id="pub-category" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none bg-white">
                        <option value="Aprendizado">Aprendizado</option>
                        <option value="Apoio Emocional">Apoio Emocional</option>
                        <option value="Habilidades">Habilidades</option>
                        <option value="Outros">Outros</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Título do Desejo</label>
                    <input type="text" id="pub-title" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none" placeholder="Ex: Quero dicas para minha lojinha">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Descrição Detalhada</label>
                    <textarea id="pub-desc" rows="3" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none resize-none" placeholder="Explique o que você precisa..."></textarea>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Melhor Horário para Videochamada</label>
                    <input type="text" id="pub-time" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none" placeholder="Ex: Noite (19h às 22h)">
                </div>
                <button type="submit" class="w-full py-3 bg-gradient-to-r from-pink-600 to-purple-600 text-white rounded-xl text-xs font-bold shadow-lg shadow-purple-500/20 mt-2">Publicar Agora</button>
            </form>
        </div>
    </div>

    <!-- Modal: Agendar Chamada -->
    <div id="schedule-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white w-full max-w-md rounded-3xl p-6 space-y-4 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                <h3 class="font-extrabold text-slate-800 text-base">Agendar Realização</h3>
                <button onclick="closeScheduleModal()" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <p class="text-xs text-slate-500" id="schedule-target-desc">Você vai realizar o desejo de <span id="sched-author" class="font-bold text-slate-700"></span>.</p>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Data da Videochamada</label>
                    <input type="date" id="sched-date" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Horário Combinado</label>
                    <input type="time" id="sched-time" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-purple-500 outline-none" value="20:00">
                </div>
                <button onclick="confirmSchedule()" class="w-full py-3 bg-purple-600 text-white rounded-xl text-xs font-bold shadow-lg shadow-purple-500/20">Confirmar Agendamento</button>
            </div>
        </div>
    </div>

    <!-- Sala de Videochamada Ao Vivo -->
    <div id="video-room" class="fixed inset-0 bg-slate-900 z-50 hidden flex flex-col justify-between p-4 text-white">
        <div class="flex justify-between items-center bg-slate-800/80 p-3 rounded-2xl backdrop-blur-md">
            <div>
                <h4 class="text-xs font-bold" id="room-title">Sala ao Vivo</h4>
                <p class="text-[10px] text-pink-400 flex items-center space-x-1">
                    <span class="w-2 h-2 rounded-full bg-pink-500 animate-pulse"></span>
                    <span>Chamada Agendada Conectada</span>
                </p>
            </div>
            <button onclick="leaveVideoRoom()" class="px-3 py-1.5 bg-red-600/80 hover:bg-red-600 text-white rounded-xl text-xs font-bold transition-all">Sair da Sala</button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 flex-1 my-4 items-center justify-center">
            <div class="relative bg-slate-800 rounded-3xl overflow-hidden aspect-video flex items-center justify-center border border-slate-700 shadow-2xl">
                <video id="webcam-video" autoplay playsinline muted class="w-full h-full object-cover"></video>
                <div id="avatar-fallback" class="absolute inset-0 flex flex-col items-center justify-center bg-gradient-to-tr from-purple-900 to-slate-900 hidden">
                    <div class="w-20 h-20 rounded-full bg-purple-600/30 flex items-center justify-center border border-purple-400/30 mb-2">
                        <i class="fa-solid fa-user text-3xl text-purple-300"></i>
                    </div>
                    <span class="text-xs font-bold text-slate-300">Câmera indisponível (Modo Simulação)</span>
                </div>
                <span class="absolute bottom-3 left-3 bg-slate-900/60 backdrop-blur-md px-2.5 py-1 rounded-lg text-[10px] font-medium">Você</span>
            </div>
            <div class="relative bg-slate-800 rounded-3xl overflow-hidden aspect-video flex items-center justify-center border border-slate-700 shadow-2xl">
                <div class="flex flex-col items-center justify-center p-6 text-center">
                    <div class="w-16 h-16 rounded-full bg-pink-600/30 flex items-center justify-center border border-pink-400/30 mb-3 animate-bounce">
                        <i class="fa-solid fa-hand-holding-heart text-2xl text-pink-300"></i>
                    </div>
                    <h5 class="text-xs font-bold" id="partner-name">Participante Conectado</h5>
                    <p class="text-[10px] text-slate-400 mt-1">Conectado ao vivo para realizar o desejo.</p>
                </div>
                <span class="absolute bottom-3 left-3 bg-slate-900/60 backdrop-blur-md px-2.5 py-1 rounded-lg text-[10px] font-medium" id="partner-label">Parceiro</span>
            </div>
        </div>

        <div class="flex justify-center space-x-4 bg-slate-800/80 p-3 rounded-2xl backdrop-blur-md max-w-xs mx-auto w-full">
            <button onclick="toggleMic()" id="mic-btn" class="w-10 h-10 rounded-xl bg-slate-700 hover:bg-slate-600 flex items-center justify-center text-sm transition-all"><i class="fa-solid fa-microphone"></i></button>
            <button onclick="toggleCam()" id="cam-btn" class="w-10 h-10 rounded-xl bg-slate-700 hover:bg-slate-600 flex items-center justify-center text-sm transition-all"><i class="fa-solid fa-video"></i></button>
            <button onclick="leaveVideoRoom()" class="w-10 h-10 rounded-xl bg-red-600 hover:bg-red-500 flex items-center justify-center text-sm transition-all"><i class="fa-solid fa-phone-slash"></i></button>
        </div>
    </div>

    <script>
        let wishes = [
            { id: 1, author: "Você (Autor)", timeAgo: "Agora mesmo", category: "Outros", title: "Quero fazer minha lojinha", desc: "Tenho um pontinho e quero fazer uma lojinha se alguém quiser me mandar qualquer coisa para mim vender nela agradeço", timeSlot: "Manhã (08h às 12h)" },
            { id: 2, author: "Ana Clara Santos", timeAgo: "Há 2 horas", category: "Aprendizado", title: "Dicas e treino de pronúncia em Inglês básico", desc: "Estou me preparando para uma entrevista simples em inglês e gostaria de treinar 15 minutos de conversação com alguém paciente.", timeSlot: "Noite (19h às 22h)" },
            { id: 3, author: "Carlos Eduardo", timeAgo: "Há 5 horas", category: "Habilidades", title: "Feedback sincero no meu primeiro Currículo", desc: "Acabei de me formar no ensino médio e montei meu primeiro CV. Queria que alguém mais experiente desse uma olhada por vídeo.", timeSlot: "Tarde (14h às 17h)" },
            { id: 4, author: "Mariana Lima", timeAgo: "Há 1 dia", category: "Aprendizado", title: "Aprender os primeiros acordes no Violão", desc: "Ganhei um violão antigo e quero muito aprender a tocar uma música simples. Alguém me ajuda com as primeiras notas?", timeSlot: "Finais de Semana" },
            { id: 5, author: "Roberto Alves", timeAgo: "Há 1 dia", category: "Apoio Emocional", title: "Conversar sobre transição de carreira para Tecnologia", desc: "Tenho 35 anos e estou migrando para a área de tecnologia. Gostaria de bater um papo para ouvir conselhos e tirar dúvidas.", timeSlot: "Manhã (08h às 12h)" }
        ];

        let agenda = [];
        let currentFilter = 'Todos';
        let activeWish = null;
        let mediaStream = null;

        function renderFeed() {
            const container = document.getElementById('feed-container');
            container.innerHTML = '';
            
            const filtered = currentFilter === 'Todos' ? wishes : wishes.filter(w => w.category === currentFilter);

            if(filtered.length === 0) {
                container.innerHTML = `<div class="text-center py-10 text-slate-400 text-xs">Nenhum desejo encontrado nesta categoria.</div>`;
                return;
            }

            filtered.forEach(wish => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-2xl p-5 border border-slate-100 shadow-sm space-y-3";
                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2.5">
                            <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-white font-bold text-xs shadow-md">
                                ${wish.author.charAt(0)}
                            </div>
                            <div>
                                <h4 class="font-bold text-xs text-slate-800">${wish.author}</h4>
                                <span class="text-[10px] text-slate-400">${wish.timeAgo}</span>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 bg-purple-50 text-purple-600 rounded-full text-[10px] font-extrabold">${wish.category}</span>
                    </div>
                    <div>
                        <h3 class="font-bold text-sm text-slate-800 mb-1">${wish.title}</h3>
                        <p class="text-xs text-slate-500 leading-relaxed">"${wish.desc}"</p>
                    </div>
                    <div class="pt-2 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-[11px] text-slate-400 flex items-center space-x-1">
                            <i class="fa-regular fa-clock text-purple-500"></i>
                            <span>${wish.timeSlot}</span>
                        </span>
                        <button onclick="openScheduleModal(${wish.id})" class="bg-gradient-to-r from-pink-600 to-purple-600 text-white px-3.5 py-1.5 rounded-xl text-[11px] font-bold shadow-md shadow-purple-500/20 active:scale-95 transition-all">
                            ❤ Quero Realizar
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function renderAgenda() {
            const container = document.getElementById('feed-container');
            container.innerHTML = `<h2 class="font-extrabold text-base text-slate-800 mb-2">Meus Agendamentos</h2>`;
            
            if(agenda.length === 0) {
                container.innerHTML += `<div class="text-center py-12 bg-white rounded-2xl border border-slate-100 p-6 space-y-2">
                    <i class="fa-regular fa-calendar-xmark text-3xl text-slate-300"></i>
                    <p class="text-xs font-bold text-slate-600">Nenhuma chamada agendada</p>
                    <p class="text-[11px] text-slate-400">Escolha um desejo no feed e clique em "Quero Realizar" para agendar sua videochamada.</p>
                </div>`;
                return;
            }

            agenda.forEach((item, idx) => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-2xl p-4 border border-slate-100 shadow-sm space-y-3";
                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-md text-[10px] font-bold">Confirmado</span>
                            <h4 class="font-bold text-xs text-slate-800 mt-1">${item.title}</h4>
                            <p class="text-[11px] text-slate-500">Com: ${item.author}</p>
                        </div>
                    </div>
                    <div class="bg-slate-50 p-2.5 rounded-xl text-xs text-slate-600 flex justify-between items-center">
                        <span>📅 ${item.date} às ${item.time}</span>
                        <button onclick="startVideoCall('${item.title}', '${item.author}')" class="bg-purple-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm hover:bg-purple-700">Entrar na Sala</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function filterCategory(cat) {
            currentFilter = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                if(btn.textContent.includes(cat) || (cat === 'Todos' && btn.textContent === 'Todos')) {
                    btn.className = "cat-btn px-4 py-1.5 rounded-full text-xs font-bold bg-purple-600 text-white shrink-0 transition-all shadow-sm";
                } else {
                    btn.className = "cat-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 shrink-0 transition-all";
                }
            });
            renderFeed();
        }

        function switchTab(tab) {
            document.getElementById('nav-feed').className = tab === 'feed' ? "flex flex-col items-center space-y-1 text-purple-600" : "flex flex-col items-center space-y-1 text-slate-400 hover:text-slate-600";
            document.getElementById('nav-agenda').className = tab === 'agenda' ? "flex flex-col items-center space-y-1 text-purple-600" : "flex flex-col items-center space-y-1 text-slate-400 hover:text-slate-600";
            
            if(tab === 'feed') renderFeed();
            else renderAgenda();
        }

        function openPublishModal() { document.getElementById('publish-modal').classList.remove('hidden'); }
        function closePublishModal() { document.getElementById('publish-modal').classList.add('hidden'); }

        function handlePublish(e) {
            e.preventDefault();
            const newWish = {
                id: Date.now(),
                author: document.getElementById('pub-author').value,
                timeAgo: "Agora mesmo",
                category: document.getElementById('pub-category').value,
                title: document.getElementById('pub-title').value,
                desc: document.getElementById('pub-desc').value,
                timeSlot: document.getElementById('pub-time').value
            };
            wishes.unshift(newWish);
            closePublishModal();
            document.getElementById('publish-form').reset();
            switchTab('feed');
        }

        function openScheduleModal(id) {
            activeWish = wishes.find(w => w.id === id);
            if(!activeWish) return;
            document.getElementById('sched-author').textContent = activeWish.author;
            document.getElementById('schedule-modal').classList.remove('hidden');
        }

        function closeScheduleModal() { document.getElementById('schedule-modal').classList.add('hidden'); }

        function confirmSchedule() {
            const date = document.getElementById('sched-date').value || "Hoje";
            const time = document.getElementById('sched-time').value || "20:00";
            
            agenda.push({
                title: activeWish.title,
                author: activeWish.author,
                date: date,
                time: time
            });

            closeScheduleModal();
            alert("Agendamento confirmado com sucesso!");
            switchTab('agenda');
        }

        async function startVideoCall(title, author) {
            document.getElementById('room-title').textContent = title;
            document.getElementById('partner-name').textContent = author;
            document.getElementById('partner-label').textContent = author;
            document.getElementById('video-room').classList.remove('hidden');

            try {
                mediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                const videoElement = document.getElementById('webcam-video');
                videoElement.srcObject = mediaStream;
                document.getElementById('avatar-fallback').classList.add('hidden');
            } catch (err) {
                document.getElementById('avatar-fallback').classList.remove('hidden');
            }
        }

        function leaveVideoRoom() {
            if(mediaStream) {
                mediaStream.getTracks().forEach(track => track.stop());
            }
            document.getElementById('video-room').classList.add('hidden');
        }

        function toggleMic() {
            if(mediaStream) {
                const audioTrack = mediaStream.getAudioTracks()[0];
                if(audioTrack) {
                    audioTrack.enabled = !audioTrack.enabled;
                    document.getElementById('mic-btn').classList.toggle('bg-red-600');
                }
            }
        }

        function toggleCam() {
            if(mediaStream) {
                const videoTrack = mediaStream.getVideoTracks()[0];
                if(videoTrack) {
                    videoTrack.enabled = !videoTrack.enabled;
                    document.getElementById('cam-btn').classList.toggle('bg-red-600');
                }
            }
        }

        // Inicializar Feed
        renderFeed();
    </script>
</body>
</html>
